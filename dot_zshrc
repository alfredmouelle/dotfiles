eval "$(fnm env --use-on-cd --shell zsh)"

alias zcfg="vim ~/.zshrc"
alias zsrc="source ~/.zshrc"

alias p=pnpm
alias g=git
alias lg='lazygit'
alias ga='git add'
alias gb='git branch'
alias gbc='git checkout'
alias gcb='git checkout -b'
alias gc='git commit -m'
alias gd='git diff'
alias gf='git fetch --prune'
alias gl='git pull'
alias gm='git merge'
alias gp='git push'
alias gpl='git pull'
alias gr='git remote'
alias brewup='brew update & brew upgrade'

# Claude & Antigravity
alias cc="claude --dangerously-skip-permissions"
alias ccc="claude --dangerously-skip-permissions -c"
alias ag="agy --dangerously-skip-permissions"

# Tmux
alias tk="tmux kill-session -t"
alias tks="tmux kill-server"

# Chezmoi
unalias dot 2>/dev/null
dot() {
  chezmoi "$@"
  case "$1" in
    apply|update)
      source ~/.zshrc
      echo "⚡ ~/.zshrc rechargé."
      ;;
  esac
}

alias dota="chezmoi add"
alias dotd="chezmoi diff"

dotp() {
  chezmoi git add -A
  chezmoi git commit -m "${1:-chore: update dotfiles}"
  chezmoi git push
}

alias cls="clear"

export HOMEBREW_NO_AUTO_UPDATE=1

if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
  export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
--color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8 \
--color=selected-bg:#45475a \
--border=rounded --layout=reverse --height=50% --prompt='❯ '"
  export BAT_THEME="Catppuccin Mocha"
  if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --exclude .git --exclude node_modules'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --strip-cwd-prefix --hidden --exclude .git --exclude node_modules'
  fi
  if command -v bat >/dev/null 2>&1; then
    export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range :300 {}' --preview-window right:50%:wrap"
  fi
fi

# Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"
export PATH="$BUN_INSTALL/bin:$HOME/.local/bin:$PATH"

# Windsurf
export PATH="$HOME/.codeium/windsurf/bin:$PATH"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# Google Cloud SDK
[ -d "/opt/homebrew/share/google-cloud-sdk/bin" ] && export PATH="/opt/homebrew/share/google-cloud-sdk/bin:$PATH"

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
# <<< grok installer <<<
