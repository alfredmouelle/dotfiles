theme = Catppuccin Mocha
font-family = GeistMono Nerd Font Mono
font-size = 16
font-style = Medium
font-style-bold = ExtraBold
font-style-italic = SemiBold Italic
font-synthetic-style = false
macos-option-as-alt = true

# Window
window-theme = dark
window-height = 35
window-width = 150
window-position-x = 180
window-position-y = 180
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-save-state = never
window-new-tab-position = current

# Quick Terminal
quick-terminal-position = center
quick-terminal-animation-duration = 0

# Notifications
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 10s

# Misc
confirm-close-surface = true
clipboard-paste-protection = false
clipboard-paste-bracketed-safe = true
quick-terminal-size = 70%,70%
quick-terminal-position = center
auto-update-channel = stable

keybind = alt+1=text:\x011
keybind = alt+2=text:\x012
keybind = alt+3=text:\x013
keybind = alt+4=text:\x014
keybind = alt+5=text:\x015
keybind = alt+6=text:\x016
keybind = alt+7=text:\x017
keybind = alt+8=text:\x018
keybind = alt+9=text:\x019
