[core]
	excludesFile = ~/.gitignore
	autocrlf = input
	editor = vim
	pager = delta

[user]
	name = Alfred MOUELLE
	email = alfredmouelle@gmail.com
	useConfigOnly = true

[fetch]
	prune = true

[push]
	default = current
	autoSetupRemote = true

[alias]
	st = status --short --branch
	graph = log --graph --oneline --decorate --all
	last = log -1 HEAD --stat
	unstage = restore --staged
	branches = branch -vv
	undo = reset --soft HEAD^

[init]
	defaultBranch = main

[help]
	autocorrect = 1

[pull]
	rebase = true

[rebase]
	autoStash = true

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[diff]
	algorithm = histogram

[commit]
	verbose = true

[interactive]
	diffFilter = delta-system --color-only

[delta]
	navigate = true

[merge]
	conflictStyle = zdiff3
