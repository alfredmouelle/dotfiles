#!/bin/bash
set -euo pipefail

ensure_symlink() {
    local source_path="$1"
    local target_path="$2"

    if [[ ! -e "$source_path" && ! -L "$source_path" ]]; then
        echo "==> Missing link source: $source_path" >&2
        return 1
    fi

    if [[ -L "$target_path" ]]; then
        unlink "$target_path"
    elif [[ -e "$target_path" ]]; then
        if [[ ! -d "$target_path" ]] || [[ -n "$(find "$target_path" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
            echo "==> Cannot replace non-empty path: $target_path" >&2
            return 1
        fi
        rmdir "$target_path"
    fi

    ln -s "$source_path" "$target_path"
}

echo "==> Running bootstrap script..."

# Ensure Homebrew is in PATH for Apple Silicon / Intel
if [[ -f "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# .Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}
if command -v brew >/dev/null 2>&1; then
    echo "==> Installing packages from Brewfile..."
    brew bundle --global
fi

# Install Node.js 24.19.0 via fnm
if command -v fnm >/dev/null 2>&1; then
    echo "==> Installing Node.js 24.19.0 with fnm..."
    eval "$(fnm env --shell bash)"
    fnm install 24.19.0
    fnm default 24.19.0
fi

# Install Bun if missing
if ! command -v bun >/dev/null 2>&1; then
    echo "==> Installing Bun..."
    curl -fsSL https://bun.sh/install | bash
fi

# Create standard developer directories
echo "==> Creating standard Developer directories..."
mkdir -p "$HOME/Developer/clients" \
         "$HOME/Developer/collab" \
         "$HOME/Developer/demos" \
         "$HOME/Developer/oss" \
         "$HOME/Developer/perso"

# Install Claude Code if missing
if ! command -v claude >/dev/null 2>&1; then
    echo "==> Installing Claude Code..."
    curl -fsSL https://claude.ai/install.sh | bash
fi

# Install Antigravity CLI if missing
if ! command -v agy >/dev/null 2>&1; then
    echo "==> Installing Antigravity CLI..."
    curl -fsSL https://antigravity.google/cli/install.sh | bash
fi

# Link AI agent configurations to the shared source (~/.agents)
echo "==> Linking AI agent configurations..."
mkdir -p "$HOME/.claude" "$HOME/.gemini" "$HOME/.codex/skills"

# Claude Code
ensure_symlink "$HOME/.agents/AGENTS.md" "$HOME/.claude/CLAUDE.md"
ensure_symlink "$HOME/.agents/docs"      "$HOME/.claude/docs"
ensure_symlink "$HOME/.agents/skills"    "$HOME/.claude/skills"
ensure_symlink "$HOME/.agents/agents"    "$HOME/.claude/agents"

# Gemini / Antigravity
ensure_symlink "$HOME/.agents/AGENTS.md" "$HOME/.gemini/GEMINI.md"
ensure_symlink "$HOME/.agents/docs"      "$HOME/.gemini/docs"
ensure_symlink "$HOME/.agents/skills"    "$HOME/.gemini/skills"
ensure_symlink "$HOME/.agents/agents"    "$HOME/.gemini/agents"

# Codex
ensure_symlink "$HOME/.agents/AGENTS.md" "$HOME/.codex/AGENTS.md"
for skill in "$HOME/.agents/skills"/*; do
    [ -d "$skill" ] || continue
    ensure_symlink "$skill" "$HOME/.codex/skills/$(basename "$skill")"
done

# Install Vim plugins
if [ -f "$HOME/.vim/autoload/plug.vim" ]; then
    echo "==> Installing Vim plugins..."
    vim +PlugInstall +qall 2>/dev/null || true
fi

echo "==> Bootstrap completed successfully!"
