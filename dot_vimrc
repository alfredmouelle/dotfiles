" Désactive la compatibilités vi 
set nocompatible

filetype plugin indent on
syntax on
set number
set mouse=a
set autoindent
set laststatus=2
set clipboard=unnamedplus

" Highligh les résultats durant la recherche
set hlsearch

" Activer l'auto complétion des fichiers en appuyant sur TAB
set wildmenu

set termguicolors

call plug#begin('~/.vim/plugged')

Plug 'itchyny/lightline.vim'
Plug 'airblade/vim-gitgutter'
Plug 'catppuccin/vim', { 'as': 'catppuccin' }

call plug#end()

" Theme
let s:catppuccin_flavor = 'mocha'
if has('macunix') && system('defaults read -g AppleInterfaceStyle 2>/dev/null') !~# 'Dark'
let s:catppuccin_flavor = 'latte'
endif

try
execute 'colorscheme catppuccin_' . s:catppuccin_flavor
let g:lightline = {'colorscheme': 'catppuccin_' . s:catppuccin_flavor}

catch /^Vim\%((\a\+)\)\=:E185/

" deal with it

endtry

let g:lightline = {'colorscheme': 'catppuccin_' . s:catppuccin_flavor}

" Wildmenu
set wildmode=list:full
set wildignorecase
set wildignore=*/.git/**/*

" Copier/Coller
noremap <Leader>y "*y
noremap <Leader>p "*p
noremap <Leader>Y "+y
noremap <Leader>P "+p

" Finder
set path=.,**
nnoremap <leader>f :find *
nnoremap <leader>s :sfind *
nnoremap <leader>v :vert sfind *
nnoremap <leader>t :tabfind *
